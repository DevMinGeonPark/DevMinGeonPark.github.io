---
import AgentCall from "@/components/AgentCall.astro";
import Boot from "@/components/Boot.astro";
import Hero from "@/components/Hero.astro";
import PostCard from "@/components/PostCard.astro";
import Base from "@/layouts/Base.astro";
import { categoriesOf, getPosts, pinnedOf } from "@/lib/posts";
import { SITE } from "@/site";

const posts = await getPosts();
const pinned = pinnedOf(posts);
const categories = ["전체", ...categoriesOf(posts)];

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: SITE.author,
	alternateName: SITE.authorEn,
	url: Astro.site,
	sameAs: [SITE.github],
	knowsAbout: ["AI Transformation", "LLM agents", "Agent workflows", "LLM evaluation"],
};
---

<Base>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<!-- Boot splash gate: before first paint, once per session, motion allowed. -->
	<script slot="head" is:inline>
		try {
			if (!sessionStorage.getItem("booted") && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
				sessionStorage.setItem("booted", "1");
				document.documentElement.classList.add("booting");
				// Safety net: never leave the page hidden if the boot script fails.
				setTimeout(() => document.documentElement.classList.remove("booting"), 4000);
			}
		} catch {}
	</script>

	<Boot />
	<AgentCall />

	<Hero />

	{pinned.length > 0 && (
		<section class="sec" aria-labelledby="pinned-h">
			<div class="sec-h">
				<h2 id="pinned-h">Pinned</h2>
				<span class="rail-nav">
					<span class="label">AI 전환 실무에 관한 글 {pinned.length}편</span>
					<button type="button" data-rail="-1" aria-label="이전 글" disabled>‹</button>
					<button type="button" data-rail="1" aria-label="다음 글">›</button>
				</span>
			</div>
			<div class="rail" data-rail-track>{pinned.map((post) => <PostCard post={post} />)}</div>
		</section>
	)}

	<section class="sec" id="all" aria-labelledby="all-h">
		<div class="sec-h">
			<h2 id="all-h">전체 글</h2>
			<div class="seg" role="group" aria-label="카테고리">
				{categories.map((c, i) => <button type="button" data-filter={c} aria-pressed={i === 0 ? "true" : "false"}>{c}</button>)}
			</div>
		</div>
		<div class="grid" data-grid>{posts.map((post) => <PostCard post={post} />)}</div>
	</section>
</Base>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
	const cards = document.querySelectorAll<HTMLElement>("[data-grid] [data-category]");
	for (const b of buttons) {
		b.addEventListener("click", () => {
			const c = b.dataset.filter;
			for (const x of buttons) x.setAttribute("aria-pressed", String(x === b));
			for (const card of cards) card.hidden = c !== "전체" && card.dataset.category !== c;
		});
	}

	// Pinned rail: ‹ › buttons step one card; mouse drag scrolls (touch swipe is native).
	const rail = document.querySelector<HTMLElement>("[data-rail-track]");
	if (rail) {
		const [prev, next] = document.querySelectorAll<HTMLButtonElement>("[data-rail]");
		const stepW = () => (rail.firstElementChild as HTMLElement).offsetWidth + 18;
		const sync = () => {
			prev.disabled = rail.scrollLeft < 4;
			next.disabled = rail.scrollLeft + rail.clientWidth > rail.scrollWidth - 4;
		};
		for (const b of [prev, next]) b.addEventListener("click", () => rail.scrollBy({ left: Number(b.dataset.rail) * stepW(), behavior: "smooth" }));
		rail.addEventListener("scroll", sync, { passive: true });
		addEventListener("resize", sync);
		sync();

		let x0 = 0, s0 = 0, moved = false;
		rail.addEventListener("pointerdown", (e) => {
			if (e.pointerType !== "mouse" || e.button !== 0) return;
			x0 = e.clientX;
			s0 = rail.scrollLeft;
			moved = false;
			const move = (ev: PointerEvent) => {
				const dx = ev.clientX - x0;
				if (!moved && Math.abs(dx) < 6) return;
				if (!moved) {
					moved = true;
					rail.classList.add("dragging");
				}
				rail.scrollLeft = s0 - dx;
			};
			const up = () => {
				removeEventListener("pointermove", move);
				removeEventListener("pointerup", up);
				if (!moved) return;
				// Let snap settle on the nearest card from where the drag ended.
				const at = rail.scrollLeft;
				rail.classList.remove("dragging");
				rail.scrollLeft = at;
				rail.scrollTo({ left: Math.round(at / stepW()) * stepW(), behavior: "smooth" });
			};
			addEventListener("pointermove", move);
			addEventListener("pointerup", up);
		});
		// A drag is not a click on the card under the pointer.
		rail.addEventListener("click", (e) => moved && (e.preventDefault(), e.stopPropagation(), (moved = false)), true);
		rail.addEventListener("dragstart", (e) => e.preventDefault());
	}
</script>

<style>
	.rail {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: min(340px, 78vw);
		gap: 18px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		padding: 4px 4px 14px;
		margin: 0 -4px;
	}
	.rail.dragging {
		scroll-snap-type: none;
		cursor: grabbing;
		user-select: none;
	}
	.rail-nav {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	.rail-nav .label {
		margin-right: 6px;
	}
	.rail-nav button {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border: 1px solid var(--rule);
		border-radius: 50%;
		background: var(--card);
		color: var(--ink);
		font-size: 18px;
		line-height: 1;
		cursor: pointer;
		transition:
			opacity 0.2s,
			border-color 0.2s;
	}
	.rail-nav button:hover:not(:disabled) {
		border-color: var(--ink);
	}
	.rail-nav button:disabled {
		opacity: 0.3;
		cursor: default;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
	}
	.seg {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 2px;
		padding: 3px;
		border-radius: 8px;
		background: var(--fill);
	}
	.seg button {
		padding: 5px 12px;
		border: 0;
		border-radius: 6px;
		background: none;
		color: var(--mute);
		font: inherit;
		font-size: 0.8rem;
		font-weight: 500;
		cursor: pointer;
	}
	.seg button[aria-pressed="true"] {
		background: var(--card);
		color: var(--ink);
		box-shadow: 0 1px 3px rgb(0 0 0 / 0.1);
	}
	@media (max-width: 900px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 560px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
