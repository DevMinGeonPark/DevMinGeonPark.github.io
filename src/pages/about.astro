---
import { getEntry } from "astro:content";
import Base from "@/layouts/Base.astro";
import "@/styles/prose.css";

const about = await getEntry("spec", "about");
if (!about) throw new Error("src/content/spec/about.md is missing");
const { Content } = await about.render();
---

<Base title="소개">
	<article class="card about prose"><Content /></article>
</Base>

<style>
	.about {
		max-width: var(--measure);
		margin: 20px auto 0;
		padding: 36px clamp(20px, 5vw, 48px);
	}
</style>
