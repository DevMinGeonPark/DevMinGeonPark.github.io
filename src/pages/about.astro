---
import { getImage } from "astro:assets";
import { getEntry } from "astro:content";
import { getPosts } from "@/lib/posts";
import profile from "@/assets/images/profile.jpg";
import AboutHero from "@/components/AboutHero.astro";
import RowList from "@/components/RowList.astro";
import Window from "@/components/Window.astro";
import Cmd from "@/components/Cmd.astro";
import { AX, CAREER, PROJECTS, RESEARCH, TALKS } from "@/data/about";
import Base from "@/layouts/Base.astro";
import { SITE } from "@/site";

const about = await getEntry("spec", "about");
if (!about) throw new Error("src/content/spec/about.md is missing");
const { Content } = await about.render();

const postCount = (await getPosts()).length;
const og = await getImage({ src: profile, width: 600 });
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	mainEntity: {
		"@type": "Person",
		name: SITE.author,
		alternateName: SITE.authorEn,
		jobTitle: "AI Engineer",
		image: new URL(og.src, Astro.site),
		url: new URL("/about/", Astro.site),
		sameAs: [SITE.github],
		knowsAbout: ["AI Transformation", "LLM agents", "RAG", "LLM evaluation"],
	},
};
---

<Base assemble title="소개" description={`${SITE.author}(${SITE.authorEn}) — AI 엔지니어. ${SITE.description}`} image={og.src}>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<AboutHero />

	<section class="sec" aria-labelledby="now-h">
		<div class="sec-h"><div><Cmd cmd="cat /etc/motd" /><h2 id="now-h" data-scramble>지금 관심사</h2></div></div>
		<Window file="/etc/motd"><div class="now"><Content /></div></Window>
	</section>

	<section class="sec" aria-labelledby="ax-h">
		<div class="sec-h"><div><Cmd cmd="systemctl status ax.service" /><h2 id="ax-h" data-scramble>하는 일</h2></div></div>
		<div class="status" data-reveal>
			<p class="mono"><span class="dot">●</span> ax.service - AI 전환 (개발자 1명 · 약 30명 규모)</p>
			<p class="mono"><span class="k">Active:</span> <span class="on">active (exited)</span> 2025-09 – 2026-09</p>
			<p class="mono"><span class="k">Stages:</span> 발굴 → 구축 → 교육 → 이관</p>
			<p class="context">{AX.context}</p>
		</div>
		<div class="ax">
			{AX.cards.map((c, i) => (
				<article class:list={["card", "ax-card", { dark: i === 0 }]} data-reveal style={`transition-delay:${i * 90}ms`}>
					<span class="big" data-scramble>{c.big}</span>
					<h3>{c.title}</h3>
					<p>{c.body}</p>
					<footer class="mono">
						<span class="stage">[{c.stage}]</span>
						{c.note && <span>* {c.note}</span>}
					</footer>
				</article>
			))}
		</div>
	</section>

	<section class="sec" aria-labelledby="career-h">
		<div class="sec-h"><div><Cmd cmd="journalctl -u career --reverse" /><h2 id="career-h" data-scramble>경력</h2></div></div>
		<Window file="journal" meta="newest first"><div class="pad"><RowList rows={CAREER} timeline /></div></Window>
	</section>

	<section class="sec" aria-labelledby="research-h">
		<div class="sec-h"><div><Cmd cmd="ls ~/research ~/talks" /><h2 id="research-h" data-scramble>연구 · 강의</h2></div></div>
		<Window file="~/research" meta={`${RESEARCH.length + TALKS.length} entries`}><div class="pad"><RowList rows={[...RESEARCH, ...TALKS]} /></div></Window>
	</section>

	<section class="sec" aria-labelledby="made-h">
		<div class="sec-h">
			<div><Cmd cmd="apt list --installed" /><h2 id="made-h" data-scramble>만든 것</h2></div>
			<a class="mono" href={SITE.github}>GitHub에서 전체 보기 ↗</a>
		</div>
		<div class="projects">
			{PROJECTS.map((p, i) => (
				<a class="card project" href={`${SITE.github}/${p.name}`} data-reveal style={`transition-delay:${(i % 3) * 70}ms`}>
					<span class="mono name">{p.name}<span class="dim">/github</span></span>
					<span class="desc">{p.desc}</span>
					<span class="mono lang">{p.lang} <span class="dim">[installed]</span></span>
					<span class="arrow" aria-hidden="true">↗</span>
				</a>
			))}
		</div>
	</section>

	<section class="card outro" data-reveal>
		<p class="mono cmd"><span class="ps">mingeon@ax-lab</span>:<span class="pa">~</span>$ ls ~/posts | wc -l<br /><span class="out">{postCount}</span></p>
		<p>작업 과정은 글로 남기고, 코드는 GitHub에 공개합니다.</p>
		<div class="outro-actions">
			<a class="pill" href={SITE.github}>GitHub @{SITE.handle}</a>
			<a class="pill go" href="/">cd ~/posts<span class="caret" aria-hidden="true"></span></a>
		</div>
	</section>
</Base>

<script>
	import { motionOk, onVisible, reveal } from "@/scripts/reveal";
	import { scramble, typeOut } from "@/scripts/scramble";
	reveal();
	if (motionOk()) {
		onVisible(".sec [data-scramble]", (el) => scramble(el));
		onVisible(".sec [data-type]", (el) => typeOut(el));
	}
</script>

<style>
	.sec-h h2 {
		font-size: 1.6rem;
	}
	.status {
		margin: 0 4px 18px;
	}
	.status .mono {
		margin: 0;
		font-size: 0.8rem;
		line-height: 1.8;
		color: var(--ink);
	}
	.dot,
	.on {
		color: #3fae2a;
		font-weight: 600;
	}
	.status .k {
		display: inline-block;
		width: 8ch;
		text-align: right;
		color: var(--mute);
	}
	.now {
		padding: 24px clamp(22px, 4vw, 40px) 28px;
	}
	.now :global(p) {
		margin: 0 0 12px;
		max-width: 52em;
		font-size: 1.12rem;
		line-height: 1.85;
	}
	.now :global(p:last-child) {
		margin: 0;
	}
	.context {
		max-width: 46em;
		margin: 12px 0 0;
		font-size: 1.05rem;
	}
	.ax {
		display: grid;
		grid-template-columns: 1.3fr 1fr 1fr;
		gap: 18px;
	}
	.ax-card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 28px 26px;
		transition:
			opacity 0.6s ease,
			transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
			box-shadow 0.2s;
	}
	.ax-card:hover {
		box-shadow: 0 10px 30px rgb(0 0 0 / 0.12);
	}
	.big {
		font-size: clamp(2rem, 3.6vw, 2.8rem);
		font-weight: 800;
		letter-spacing: -0.05em;
		line-height: 1.1;
	}
	.ax-card h3 {
		margin: 6px 0 0;
		font-size: 1.05rem;
	}
	.ax-card p {
		margin: 0;
		font-size: 0.92rem;
		color: var(--mute);
	}
	.ax-card footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 6px 12px;
		margin-top: auto;
		padding-top: 16px;
	}
	.stage {
		color: var(--brand);
	}
	.dark .stage {
		color: var(--term-green);
	}
	.dark {
		background: var(--term-bg);
		color: var(--term-fg);
	}
	.dark .big {
		background: linear-gradient(90deg, var(--term-green), var(--term-key));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.dark p,
	.dark footer {
		color: var(--term-mute);
	}
	.pad {
		padding: 8px 28px;
	}
	.projects {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
	}
	.project {
		position: relative;
		display: grid;
		gap: 6px;
		padding: 22px 24px;
		transition:
			opacity 0.6s ease,
			transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
			box-shadow 0.2s;
	}
	.project:hover {
		box-shadow: 0 10px 30px rgb(0 0 0 / 0.12);
	}
	.project:hover .arrow {
		transform: translate(3px, -3px);
		color: var(--ink);
	}
	.name {
		font-size: 0.92rem;
		font-weight: 500;
		color: var(--ink);
	}
	.desc {
		font-size: 0.9rem;
		color: var(--mute);
	}
	.lang {
		margin-top: 8px;
	}
	.lang::before {
		content: "● ";
		color: var(--brand);
	}
	.outro {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 16px 32px;
		margin-top: 48px;
		padding: 26px clamp(22px, 4vw, 40px);
		background: var(--term-bg);
		color: var(--term-fg);
	}
	.outro p {
		margin: 0;
		font-size: 1.02rem;
	}
	.cmd {
		font-size: 0.8rem;
		line-height: 1.7;
		color: var(--term-fg);
	}
	.ps {
		color: var(--term-green);
		font-weight: 600;
	}
	.pa {
		color: var(--term-key);
		font-weight: 600;
	}
	.out {
		font-size: 1.6rem;
		font-weight: 600;
		color: #fff;
	}
	.outro-actions {
		display: flex;
		gap: 8px;
	}
	.outro .pill {
		height: 38px;
		padding: 0 16px;
		font-family: var(--mono);
		font-size: 0.82rem;
		background: #1e2024;
		color: var(--term-fg);
	}
	.outro .go {
		display: inline-flex;
		align-items: center;
		background: var(--term-green);
		color: var(--term-bg);
	}
	.caret {
		width: 7px;
		height: 1em;
		margin-left: 4px;
		background: currentColor;
		animation: blink 1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	.dim {
		color: var(--mute);
	}
	.arrow {
		position: absolute;
		top: 18px;
		right: 20px;
		color: var(--mute);
		transition: transform 0.2s;
	}
	@media (max-width: 900px) {
		.ax,
		.projects {
			grid-template-columns: 1fr 1fr;
		}
		.ax-card.dark {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 860px) {
		.outro {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 560px) {
		.ax,
		.projects {
			grid-template-columns: 1fr;
		}
	}
</style>
