---
import CommandPalette from "@/components/CommandPalette.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/site";
import "@/styles/tokens.css";
import "@/styles/base.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
	/** Play the piece-by-piece entry once per session (see src/scripts/assemble.ts). */
	assemble?: boolean;
}

const { title, description = SITE.description, image, type = "website", assemble = false } =
	Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — ${SITE.author}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={SITE.author} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
		<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={SITE.title} />
		<meta property="og:title" content={title ?? SITE.title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+KR:wght@400;500;700&display=swap"
		/>

		<!-- Apply the saved theme before paint to avoid a flash. -->
		<script is:inline>
			try {
				const t = localStorage.getItem("theme");
				if (t) document.documentElement.dataset.theme = t;
			} catch {}
		</script>
		{assemble && (
			<script is:inline>
				// Hide before first paint; the page script assembles it. Safety net after 8s.
				try {
					const k = "seq:" + location.pathname;
					if (!sessionStorage.getItem(k) && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
						sessionStorage.setItem(k, "1");
						document.documentElement.classList.add("pre", "assembling");
						setTimeout(() => document.documentElement.classList.remove("pre", "assembling"), 8000);
					}
				} catch {}
			</script>
		)}
		<slot name="head" />
	</head>
	<body>
		<Header />
		<main class="container">
			<slot />
		</main>
		<Footer />
		<CommandPalette />
		<script>
			import "@/scripts/nav";
		</script>
	</body>
</html>
