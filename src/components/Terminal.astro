---
// Static output is the no-JS / crawler view; terminal.ts replays it interactively.
import { execSync } from "node:child_process";
import { profileHtml } from "@/scripts/terminal-commands";

// Real commit history for the `git log` command, read at build time.
let gitlog: string[] = [];
try {
	gitlog = execSync("git log -n 15 --date=short --pretty=format:%h%x09%ad%x09%s", { encoding: "utf8" }).split("\n").filter(Boolean);
} catch {
	// not a git checkout: command reports an empty log
}

const prompt = '<span class="p"><b>mingeon@ax-lab</b> ~ % </span>';
---

<div class="term" data-terminal data-prompt={prompt} data-gitlog={JSON.stringify(gitlog)}>
	<div data-out aria-live="polite">
		<div class="ln" set:html={`${prompt}whoami --verbose`} />
		<div class="ln" set:html={profileHtml()} />
	</div>
	<label class="input-line">
		<Fragment set:html={prompt} />
		<input type="text" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="help" aria-label="터미널 명령어 입력" />
	</label>
</div>

<style>
	.term {
		position: relative;
		contain: size;
		min-height: 380px;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 32px 32px 26px;
		background: var(--term-bg);
		color: var(--term-fg);
		font-family: var(--mono);
		font-size: 0.8rem;
		line-height: 1.75;
		cursor: text;
	}
	.term :global(.ln) {
		white-space: pre-wrap;
		margin-bottom: 6px;
	}
	.term :global(.p) {
		color: var(--term-mute);
		white-space: pre;
	}
	.term :global(.p b) {
		color: var(--term-green);
		font-weight: 500;
	}
	.term :global(.k) {
		color: var(--term-key);
	}
	.term :global(.m) {
		color: var(--term-mute);
	}
	.term :global(b) {
		color: #fff;
		font-weight: 500;
	}
	.term :global(a) {
		color: var(--term-key);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.term :global(.y) {
		color: var(--term-yellow);
	}
	.term :global(.warn) {
		color: var(--term-key);
	}
	/* `random`: one-line reel that spins down to the picked title. */
	.term :global(.slot) {
		display: block;
		height: 1lh;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		color: var(--term-green);
	}
	.term :global(.slot > span) {
		display: block;
		animation: reel 1.5s cubic-bezier(0.15, 0.6, 0.2, 1) forwards;
	}
	@keyframes reel {
		to {
			transform: translateY(calc(var(--n) * -1lh));
		}
	}
	.term :global(.heat) {
		display: grid;
		grid-auto-flow: column;
		grid-template-rows: repeat(7, 9px);
		grid-auto-columns: 9px;
		gap: 2px;
		width: max-content;
		margin: 4px 0 6px;
	}
	.term :global(.heat :is(i, a)) {
		border-radius: 2px;
		background: var(--heat-0);
	}
	/* Days with posts are links. */
	.term :global(.heat a) {
		transition: transform 0.15s;
	}
	.term :global(.heat a:hover) {
		transform: scale(1.5);
		outline: 1px solid var(--term-fg);
	}
	.term :global(.heat .l1) { background: var(--heat-1); }
	.term :global(.heat .l2) { background: var(--heat-2); }
	.term :global(.heat .l3) { background: var(--heat-3); }
	.term :global(.heat .l4) { background: var(--heat-4); }
	/* Full-screen programs (src/scripts/terminal-apps.ts). */
	.term.in-app {
		overflow: hidden;
	}
	.term :global(.screen) {
		position: absolute;
		left: 0;
		right: 0;
		z-index: 2;
		padding: 18px 24px 0;
		background: var(--term-bg);
		overflow: hidden;
	}
	.term :global(.vim) {
		display: flex;
		flex-direction: column;
		height: 100%;
	}
	.term :global(.buf) {
		flex: 1;
		margin: 0;
		overflow: hidden;
		font: inherit;
		line-height: 20px;
		white-space: pre-wrap;
	}
	.term :global(.buf.splash) {
		text-align: center;
	}
	.term :global(.tl) {
		color: var(--term-key);
	}
	.term :global(.vst) {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		padding: 2px 8px;
		background: var(--term-fg);
		color: var(--term-bg);
		white-space: nowrap;
		overflow: hidden;
	}
	.term :global(.sn-bar) {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		height: 26px;
		color: var(--term-mute);
		white-space: nowrap;
		overflow: hidden;
	}
	.term :global(.sn-bar [data-score]) {
		color: var(--term-green);
	}
	.term :global(.ty p) {
		margin: 0 0 12px;
	}
	.term :global(.ty-t) {
		font-family: var(--sans);
		font-size: 1.15rem;
		line-height: 1.7;
	}
	.term :global(.ty-t .todo) {
		color: var(--term-mute);
	}
	.term :global(.ty-t .ok) {
		color: var(--term-green);
	}
	.term :global(.ty-t .bad) {
		color: var(--term-yellow);
		text-decoration: underline wavy;
	}
	.input-line {
		display: flex;
		align-items: baseline;
	}
	input {
		flex: 1;
		min-width: 0;
		padding: 0;
		border: 0;
		outline: 0;
		background: none;
		color: var(--term-fg);
		font: inherit;
		caret-color: var(--term-green);
	}
	input::placeholder {
		color: #3f4440;
	}
	@media (max-width: 780px) {
		.term {
			min-height: 300px;
			padding: 24px 20px 20px;
		}
	}
</style>
