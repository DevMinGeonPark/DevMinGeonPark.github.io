---
// Boot log + neofetch: the about page opens like an SSH session into a server.
import { Image } from "astro:assets";
import profile from "@/assets/images/profile.jpg";
import { PROJECTS, STACK, STATS } from "@/data/about";
import { getPosts } from "@/lib/posts";
import { PROFILE, SITE } from "@/site";

const BOOT = [
	"Mounted /home/mingeon.",
	"Started claude-code.service.",
	"Started codex.service.",
	"Started amux.service - agent-aware tmux sessions.",
	"Reached target 기록.",
];
const stats = [
	...STATS,
	{ value: PROJECTS.length, unit: "개", label: "공개 프로젝트" },
	{ value: (await getPosts()).length, unit: "편", label: "블로그 글" },
];
---

<section class="hero">
	<div class="boot mono" aria-hidden="true">
		{BOOT.map((l) => <p data-boot><span class="ok">[  OK  ]</span> {l}</p>)}
	</div>
	<p class="mono cmd" data-boot><span class="ps">mingeon@ax-lab</span>:<span class="path">~</span>$ <span data-type>neofetch</span></p>

	<div class="fetch" data-fetch>
		<Image class="pixel" src={profile} alt={`${SITE.author} 프로필 사진`} width={72} loading="eager" />
		<div class="info">
			<p class="mono host"><span class="ps">mingeon</span>@<span class="ps">ax-lab</span></p>
			<h1><span data-scramble>{SITE.author}</span> <small class="mono">{SITE.authorEn}</small></h1>
			<p class="lead">{SITE.description}</p>
			<dl class="rows mono">
				<div><dt>role</dt><dd>AI 엔지니어 · AX</dd></div>
				{PROFILE.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
			</dl>
			<dl class="stats">
				{stats.map((s) => (
					<div>
						<dt>{s.label}</dt>
						<dd><b data-count={s.value}>{s.value}</b>{s.unit}</dd>
					</div>
				))}
			</dl>
			<div class="swatches" aria-hidden="true">{Array.from({ length: 8 }, () => <i />)}</div>
			<div class="links">
				<a class="pill" href={SITE.github}>GitHub @{SITE.handle}</a>
				<a class="pill" href="/rss.xml">RSS</a>
				<a class="pill" href="/">글 목록</a>
			</div>
		</div>
	</div>

	<div class="marquee" aria-hidden="true">
		<div class="track">
			{[0, 1].map(() => STACK.map((s) => <span>{s}</span>))}
		</div>
	</div>
</section>

<script>
	import { motionOk } from "@/scripts/reveal";
	import { scramble, typeOut, wait } from "@/scripts/scramble";

	function countUp() {
		for (const el of document.querySelectorAll<HTMLElement>(".hero [data-count]")) {
			const target = Number(el.dataset.count);
			const start = performance.now();
			const tick = (now: number) => {
				const t = Math.min(1, Math.max(0, now - start) / 1100);
				el.textContent = String(Math.round(target * (1 - (1 - t) ** 3)));
				if (t < 1) requestAnimationFrame(tick);
			};
			requestAnimationFrame(tick);
		}
	}

	// Boot lines appear one by one, `neofetch` is typed, then the info block fades in.
	// Everything is visible without JS or with reduced motion.
	async function boot() {
		const hero = document.querySelector<HTMLElement>(".hero")!;
		const lines = hero.querySelectorAll<HTMLElement>("[data-boot]");
		const cmd = hero.querySelector<HTMLElement>("[data-type]")!;
		const fetch = hero.querySelector<HTMLElement>("[data-fetch]")!;
		hero.classList.add("booting");
		for (const l of lines) {
			l.classList.add("on");
			await wait(110);
		}
		await typeOut(cmd, 55);
		await wait(160);
		fetch.classList.add("on");
		scramble(hero.querySelector<HTMLElement>("[data-scramble]")!);
		countUp();
	}

	if (motionOk()) boot();
</script>

<style>
	.hero {
		overflow: hidden;
		margin-top: 20px;
		border-radius: var(--r);
		background:
			radial-gradient(90% 70% at 100% 0%, rgb(142 163 255 / 0.14), transparent 60%),
			var(--term-bg);
		color: var(--term-fg);
		box-shadow: var(--shadow);
	}
	.boot,
	.cmd {
		margin: 0;
		padding: 0 clamp(20px, 4vw, 44px);
		font-size: 0.8rem;
		line-height: 1.8;
		color: var(--term-fg);
	}
	.boot {
		padding-top: 26px;
	}
	.boot p {
		margin: 0;
		white-space: pre;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.ok {
		color: var(--term-green);
	}
	.cmd {
		margin-top: 10px;
	}
	.ps {
		color: var(--term-green);
		font-weight: 600;
	}
	.path {
		color: var(--term-key);
		font-weight: 600;
	}
	/* Hidden states only exist while the boot script runs. */
	.booting [data-boot] {
		visibility: hidden;
	}
	.booting [data-boot].on {
		visibility: visible;
	}
	.booting [data-fetch] {
		opacity: 0;
		transform: translateY(12px);
		transition:
			opacity 0.6s ease,
			transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.booting [data-fetch].on {
		opacity: 1;
		transform: none;
	}

	.fetch {
		display: grid;
		grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
		gap: clamp(24px, 4vw, 52px);
		align-items: start;
		padding: 26px clamp(20px, 4vw, 44px) 36px;
	}
	/* Low-res source scaled up with nearest-neighbour: reads as pixel art, not a portrait. */
	.fetch :global(.pixel) {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: 50% 15%;
		image-rendering: pixelated;
		border-radius: 6px;
		filter: grayscale(1) contrast(1.1) brightness(0.9);
	}
	.info {
		display: flex;
		flex-direction: column;
		gap: 14px;
		min-width: 0;
	}
	.host {
		margin: 0;
		padding-bottom: 10px;
		border-bottom: 1px dashed rgb(255 255 255 / 0.18);
		font-size: 0.86rem;
		color: var(--term-fg);
	}
	h1 {
		margin: 0;
		font-size: clamp(2.6rem, 5.4vw, 4rem);
		font-weight: 800;
		letter-spacing: -0.05em;
		line-height: 1.05;
		color: #fff;
	}
	h1 small {
		margin-left: 6px;
		font-size: 0.9rem;
		font-weight: 400;
		letter-spacing: 0;
		color: var(--term-mute);
	}
	.lead {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.65;
	}
	.rows {
		display: grid;
		gap: 2px;
		margin: 0;
		font-size: 0.84rem;
		line-height: 1.7;
	}
	.rows div {
		display: grid;
		grid-template-columns: 7ch minmax(0, 1fr);
		gap: 10px;
	}
	.rows dt {
		color: var(--term-key);
		font-weight: 600;
	}
	.rows dd {
		margin: 0;
		color: var(--term-fg);
	}
	.stats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 8px;
		margin: 6px 0 0;
	}
	.stats div {
		padding: 12px 14px 10px;
		border: 1px solid rgb(255 255 255 / 0.1);
		border-radius: 8px;
		background: rgb(255 255 255 / 0.04);
	}
	.stats dt {
		font-size: 0.76rem;
		color: var(--term-mute);
	}
	.stats dd {
		margin: 2px 0 0;
		font-size: 0.86rem;
		color: var(--term-mute);
	}
	.stats b {
		margin-right: 2px;
		font-family: var(--mono);
		font-size: 1.8rem;
		font-weight: 700;
		color: #fff;
		font-variant-numeric: tabular-nums;
	}
	/* neofetch colour blocks */
	.swatches {
		display: flex;
	}
	.swatches i {
		width: 26px;
		height: 14px;
	}
	.swatches i:nth-child(1) { background: #2e3436; }
	.swatches i:nth-child(2) { background: #cc0000; }
	.swatches i:nth-child(3) { background: #4e9a06; }
	.swatches i:nth-child(4) { background: #c4a000; }
	.swatches i:nth-child(5) { background: #3465a4; }
	.swatches i:nth-child(6) { background: #75507b; }
	.swatches i:nth-child(7) { background: #06989a; }
	.swatches i:nth-child(8) { background: #d3d7cf; }
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.links .pill {
		background: rgb(255 255 255 / 0.08);
		color: var(--term-fg);
		font-family: var(--mono);
	}
	.links .pill:hover {
		background: var(--term-green);
		color: var(--term-bg);
	}
	.marquee {
		overflow: hidden;
		padding: 14px 0;
		border-top: 1px solid rgb(255 255 255 / 0.08);
		background: rgb(0 0 0 / 0.25);
		mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
	}
	.track {
		display: flex;
		gap: 28px;
		width: max-content;
		animation: slide 40s linear infinite;
	}
	.track span {
		font-family: var(--mono);
		font-size: 0.8rem;
		white-space: nowrap;
	}
	.track span::before {
		content: "▸ ";
		color: var(--term-green);
	}
	@keyframes slide {
		to {
			transform: translateX(-50%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.track {
			animation: none;
		}
	}
	@media (max-width: 860px) {
		.fetch {
			grid-template-columns: 1fr;
		}
		.fetch :global(.pixel) {
			width: 160px;
		}
		.stats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
