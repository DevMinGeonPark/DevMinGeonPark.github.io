---
import type { MarkdownHeading } from "astro";

interface Props {
	headings: MarkdownHeading[];
}
const items = Astro.props.headings.filter((h) => h.depth <= 3);
---

{items.length > 0 && (
	<nav class="toc" aria-label="이 글의 목차">
		<span class="label">목차</span>
		<ol>
			{items.map((h) => (
				<li class={`d${h.depth}`}><a href={`#${h.slug}`} data-toc-link>{h.text.replace(/#$/, "").trim()}</a></li>
			))}
		</ol>
	</nav>
)}

<script>
	// Highlight the section currently at the top of the viewport.
	const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
	const targets = links
		.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
		.filter((el): el is HTMLElement => el !== null);

	function update() {
		let current = 0;
		targets.forEach((el, i) => {
			if (el.getBoundingClientRect().top < 120) current = i;
		});
		links.forEach((a, i) => a.classList.toggle("on", i === current));
	}
	if (links.length) {
		addEventListener("scroll", update, { passive: true });
		update();
	}
</script>

<style>
	.toc {
		position: sticky;
		top: 84px;
		align-self: start;
		max-height: calc(100vh - 120px);
		overflow-y: auto;
		padding: 18px 0 18px 4px;
	}
	ol {
		list-style: none;
		margin: 12px 0 0;
		padding: 0;
		display: grid;
		gap: 2px;
		border-left: 1px solid var(--rule);
	}
	a {
		display: block;
		margin-left: -1px;
		padding: 5px 0 5px 14px;
		border-left: 2px solid transparent;
		font-size: 0.84rem;
		line-height: 1.45;
		color: var(--mute);
		transition: color 0.15s, border-color 0.15s;
	}
	.d3 a {
		padding-left: 26px;
		font-size: 0.8rem;
	}
	a:hover {
		color: var(--ink);
	}
	a.on {
		color: var(--ink);
		font-weight: 600;
		border-left-color: var(--ink);
	}
</style>
