---
// Post navigation: a compact floating command bar (prev / position / copy / next)
// that tucks away while reading down, plus full prev/next cards at the end of the article.
interface Link {
	url: string;
	title: string;
}
interface Props {
	prev?: Link; // older
	next?: Link; // newer
	position: string;
}
const { prev, next, position } = Astro.props;
const chevron = (d: string) =>
	`<svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true"><path d="${d}" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

{(prev || next) && (
	<nav class="pager" aria-label="이전 · 다음 글">
		{prev ? (
			<a class="pg" href={prev.url}><span class="label">← 이전 글</span><b>{prev.title}</b></a>
		) : <span />}
		{next && <a class="pg nx" href={next.url}><span class="label">다음 글 →</span><b>{next.title}</b></a>}
	</nav>
)}

<div class="dock" data-dock>
	<div class="bar">
		<a class="b" href={prev?.url} aria-disabled={prev ? undefined : "true"} aria-label={prev ? `이전 글: ${prev.title}` : "이전 글 없음"} data-tip={prev?.title} data-prev set:html={chevron("M13 4l-6 6 6 6")} />
		<span class="pos mono" aria-label={`${position}번째 글`}>{position}</span>
		<button class="b" type="button" data-copy aria-label="링크 복사" data-tip="링크 복사">
			<svg width="15" height="15" viewBox="0 0 20 20" aria-hidden="true"><path d="M8 12l4-4M7 9l-2 2a3 3 0 0 0 4 4l2-2M13 11l2-2a3 3 0 0 0-4-4L9 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
		</button>
		<a class="b" href={next?.url} aria-disabled={next ? undefined : "true"} aria-label={next ? `다음 글: ${next.title}` : "다음 글 없음"} data-tip={next?.title} data-next set:html={chevron("M7 4l6 6-6 6")} />
	</div>
	<div class="toast mono" role="status" hidden></div>
</div>

<script>
	import { roll } from "@/scripts/roll";

	const dock = document.querySelector<HTMLElement>("[data-dock]");
	const toast = dock?.querySelector<HTMLElement>(".toast");
	let timer: ReturnType<typeof setTimeout>;
	const show = (msg: string) => {
		if (!toast) return;
		toast.textContent = msg;
		toast.hidden = false;
		clearTimeout(timer);
		timer = setTimeout(() => (toast.hidden = true), 1600);
	};

	// Position counter rolls in like an odometer.
	const pos = dock?.querySelector<HTMLElement>(".pos");
	if (pos) setTimeout(() => roll(pos, pos.textContent!.trim()), 300);

	document.querySelector("[data-copy]")?.addEventListener("click", async () => {
		try {
			await navigator.clipboard.writeText(location.href);
			show("✓ 링크 복사됨");
		} catch {
			show("복사할 수 없어요. 주소창에서 복사해주세요");
		}
	});

	// Tuck the bar away while scrolling down through the text and once the end-of-article pager
	// is on screen (it does the same job there); bring it back on scroll up.
	let lastY = scrollY;
	let atPager = false;
	const sync = (down: boolean) => dock?.classList.toggle("away", atPager || (down && scrollY > 300));
	const pager = document.querySelector(".pager");
	if (pager)
		new IntersectionObserver(([e]) => {
			atPager = e.isIntersecting;
			sync(false);
		}).observe(pager);
	addEventListener(
		"scroll",
		() => {
			const d = scrollY - lastY;
			if (Math.abs(d) < 6) return;
			sync(d > 0);
			lastY = scrollY;
		},
		{ passive: true },
	);

	addEventListener("keydown", (e) => {
		if (e.target instanceof HTMLInputElement || e.metaKey || e.ctrlKey || e.altKey) return;
		const sel = e.key === "ArrowLeft" ? "[data-prev]" : e.key === "ArrowRight" ? "[data-next]" : null;
		const href = sel && document.querySelector<HTMLAnchorElement>(sel)?.getAttribute("href");
		if (href) location.href = href;
	});
</script>

<style>
	/* End-of-article pager */
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
		max-width: var(--max);
		margin: 0 auto 56px;
	}
	.pg {
		display: grid;
		gap: 6px;
		padding: 18px 22px;
		background: var(--card);
		border-radius: var(--r);
		box-shadow: var(--shadow);
		transition: transform 0.15s, box-shadow 0.15s;
	}
	.pg:hover {
		transform: translateY(-2px);
		box-shadow: 0 0 0 1px var(--brand), var(--shadow);
	}
	.pg b {
		font-size: 0.98rem;
		line-height: 1.45;
		text-wrap: balance;
	}
	.nx {
		grid-column: 2;
		text-align: right;
	}
	@media (max-width: 640px) {
		.pager {
			grid-template-columns: 1fr;
		}
		.nx {
			grid-column: 1;
		}
	}

	/* Floating command bar */
	.dock {
		position: fixed;
		left: 50%;
		bottom: calc(18px + env(safe-area-inset-bottom, 0px));
		z-index: 20;
		transform: translateX(-50%);
		transition:
			transform 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.15),
			opacity 0.25s;
	}
	.dock.away {
		transform: translate(-50%, calc(100% + 30px));
		opacity: 0;
	}
	.bar {
		display: flex;
		align-items: center;
		gap: 2px;
		padding: 4px;
		background: color-mix(in srgb, var(--card) 88%, transparent);
		backdrop-filter: blur(12px) saturate(1.4);
		-webkit-backdrop-filter: blur(12px) saturate(1.4);
		box-shadow:
			0 0 0 0.5px color-mix(in srgb, var(--ink) 16%, transparent),
			0 12px 30px -12px color-mix(in srgb, var(--ink) 35%, transparent);
	}
	.b {
		position: relative;
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		border: 0;
		background: transparent;
		color: var(--ink);
		cursor: pointer;
		transition: background-color 0.15s, color 0.15s;
	}
	.b:hover {
		background: color-mix(in srgb, var(--brand) 12%, transparent);
		color: var(--brand);
	}
	.b[aria-disabled="true"] {
		opacity: 0.25;
		pointer-events: none;
	}
	/* Title preview above the button. */
	.b[data-tip]:hover::after {
		content: attr(data-tip);
		position: absolute;
		bottom: calc(100% + 12px);
		left: 50%;
		transform: translateX(-50%);
		width: max-content;
		max-width: 260px;
		padding: 6px 10px;
		background: var(--ink);
		color: var(--card);
		font-size: 12px;
		line-height: 1.4;
		text-align: left;
		pointer-events: none;
	}
	.pos {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 84px;
		height: 38px;
		padding: 0 12px;
		border-inline: 1px solid var(--rule);
		font-size: 11.5px;
		font-variant-numeric: tabular-nums;
		color: var(--ink);
	}
	.toast {
		position: absolute;
		left: 50%;
		bottom: calc(100% + 12px);
		transform: translateX(-50%);
		padding: 7px 14px;
		background: var(--ink);
		color: var(--card);
		white-space: nowrap;
		animation: toast 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.2);
	}
	@keyframes toast {
		from {
			opacity: 0;
			transform: translate(-50%, 6px);
		}
	}
</style>
