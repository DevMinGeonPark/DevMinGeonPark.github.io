---
import { SITE } from "@/site";
---

<footer class="container">
	<span class="label">© {new Date().getFullYear()} {SITE.author} · <a href={SITE.license.url}>{SITE.license.name}</a></span>
	<span class="label"><a href="/rss.xml">RSS</a> · <a href="/sitemap-index.xml">sitemap</a> · <a href="/llms.txt">llms.txt</a></span>
</footer>

<style>
	footer {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
		padding-block: 56px 40px;
	}
	a:hover {
		color: var(--ink);
	}
</style>
