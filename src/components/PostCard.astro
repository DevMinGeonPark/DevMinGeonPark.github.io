---
import { Image } from "astro:assets";
import { dotDate, type Post, postUrl } from "@/lib/posts";

interface Props {
	post: Post;
}
const { post } = Astro.props;
const { title, description, category, published, image } = post.data;
---

<a class="card post-card" href={postUrl(post.slug)} data-category={category}>
	{image ? <Image src={image} alt="" width={680} loading="lazy" /> : <div class="ph"></div>}
	<div class="b">
		<span class="label">{category} · <time datetime={published.toISOString()}>{dotDate(published)}</time></span>
		<h3>{title}</h3>
		<p>{description}</p>
	</div>
</a>

<style>
	.post-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		scroll-snap-align: start;
		transition: transform 0.15s;
	}
	.post-card:hover {
		transform: translateY(-2px);
	}
	img,
	.ph {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1.9;
		object-fit: cover;
		background: var(--fill);
		filter: var(--thumb);
	}
	.b {
		display: grid;
		gap: 4px;
		padding: 14px 16px 16px;
	}
	h3 {
		margin: 0;
		font-size: 1.02rem;
		font-weight: 800;
		letter-spacing: -0.025em;
		line-height: 1.4;
		text-wrap: balance;
	}
	p {
		margin: 0;
		font-size: 0.86rem;
		line-height: 1.55;
		color: var(--mute);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
