---
import { Image } from "astro:assets";
import { dotDate, type Post, postUrl } from "@/lib/posts";

interface Props {
	post: Post;
}
const { post } = Astro.props;
const { title, description, category, published, image } = post.data;
---

<a class="card post-card" href={postUrl(post.slug)} data-category={category}>
	{image ? <Image src={image} alt="" width={680} loading="lazy" /> : <div class="ph"></div>}
	<div class="b">
		<span class="label">{category} · <time datetime={published.toISOString()}>{dotDate(published)}</time></span>
		<h3>{title}</h3>
		<p>{description}</p>
	</div>
</a>

<script>
	// Desktop pointers only; touch and reduced-motion keep the flat card.
	if (matchMedia("(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)").matches) {
		for (const card of document.querySelectorAll<HTMLElement>(".post-card")) {
			card.addEventListener("pointermove", (e) => {
				const r = card.getBoundingClientRect();
				const x = (e.clientX - r.left) / r.width;
				const y = (e.clientY - r.top) / r.height;
				card.style.setProperty("--rx", `${(0.5 - y) * 6}deg`);
				card.style.setProperty("--ry", `${(x - 0.5) * 8}deg`);
				card.style.setProperty("--gx", `${x * 100}%`);
				card.style.setProperty("--gy", `${y * 100}%`);
			});
			card.addEventListener("pointerleave", () => {
				for (const v of ["--rx", "--ry", "--gx", "--gy"]) card.style.removeProperty(v);
			});
		}
	}
</script>

<style>
	/* Tilt toward the pointer (vars set by the script below) with a soft glare. */
	.post-card {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		scroll-snap-align: start;
		transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translateY(var(--ty, 0px));
		transition: transform 0.2s ease-out;
	}
	.post-card:hover {
		--ty: -2px;
	}
	.post-card::after {
		content: "";
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(circle at var(--gx, 50%) var(--gy, 50%), rgb(255 255 255 / 0.22), transparent 50%);
		mix-blend-mode: soft-light;
		opacity: 0;
		transition: opacity 0.25s;
	}
	.post-card:hover::after {
		opacity: 1;
	}
	.post-card img {
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.post-card:hover img {
		transform: scale(1.035);
	}
	img,
	.ph {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1.9;
		object-fit: cover;
		background: var(--fill);
		filter: var(--thumb);
	}
	.b {
		display: grid;
		gap: 4px;
		padding: 14px 16px 16px;
	}
	h3 {
		margin: 0;
		font-size: 1.02rem;
		font-weight: 800;
		letter-spacing: -0.025em;
		line-height: 1.4;
		text-wrap: balance;
	}
	p {
		margin: 0;
		font-size: 0.86rem;
		line-height: 1.55;
		color: var(--mute);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
